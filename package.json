{
  "name": "markdown-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@milkdown/core": "^7.5.8",
    "@milkdown/ctx": "^7.5.8",
    "@milkdown/plugin-listener": "^7.5.8",
    "@milkdown/preset-commonmark": "^7.5.8",
    "@milkdown/preset-gfm": "^7.5.8",
    "@milkdown/prose": "^7.5.8",
    "@milkdown/react": "^7.5.8",
    "@milkdown/theme-nord": "^7.5.8",
    "@milkdown/transformer": "^7.5.8",
    "@milkdown/utils": "^7.5.8",
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "codemirror": "^6.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
